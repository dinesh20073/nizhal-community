# Nizhal Custom Email Backend Configuration
# 1. Go to your Google Account -> Security (https://myaccount.google.com/security)
# 2. Enable 2-Step Verification
# 3. Search for "App Passwords" -> Create one called "Nizhal Website"
# 4. Paste the 16-character generated password below

GMAIL_USER=nizhal.community@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password_here
PORT=5000
