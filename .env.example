# Nizhal Custom Email Backend Configuration
# 1. Go to your Google Account -> Security (https://myaccount.google.com/security)
# 2. Enable 2-Step Verification
# 3. Search for "App Passwords" -> Create one called "Nizhal Website"
# 4. Paste the 16-character generated password below

GMAIL_USER=nizhal.community@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password_here
PORT=5000

# Media API Backend Endpoint (pointing to your deployed Vercel backend)
VITE_MEDIA_API_URL=https://your-backend-domain.vercel.app/api/media
NEXT_PUBLIC_MEDIA_API_URL=https://your-backend-domain.vercel.app/api/media

# Meta Instagram Graph API Configuration
# Option A: Direct Long-Lived Access Token (Recommended & Easiest for Vercel)
# Can be generated directly from Meta Graph API Explorer or Meta Business Suite
INSTAGRAM_ACCESS_TOKEN=your_long_lived_instagram_access_token_here
INSTAGRAM_USER_ID=me

# Option B: Meta Unified OAuth Login Flow
# Register this Exact Callback in Meta App Dashboard > Instagram Basic Display > Valid OAuth Redirect URIs
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
INSTAGRAM_REDIRECT_URI=https://your-domain.vercel.app/api/instagram/callback
