{
  "redirects": [
    {
      "source": "/register",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/register/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/pay",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/pay/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/pass",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/pass/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/status",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/status/",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/register/:path*",
      "destination": "https://admin.nizhalcommunity.in/register/:path*"
    },
    {
      "source": "/pay/:path*",
      "destination": "https://admin.nizhalcommunity.in/pay/:path*"
    },
    {
      "source": "/pass/:path*",
      "destination": "https://admin.nizhalcommunity.in/pass/:path*"
    },
    {
      "source": "/status/:path*",
      "destination": "https://admin.nizhalcommunity.in/status/:path*"
    },
    {
      "source": "/static/:path*",
      "destination": "https://admin.nizhalcommunity.in/static/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://admin.nizhalcommunity.in/media/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

