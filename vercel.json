{
  "redirects": [
    {
      "source": "/register",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/register/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/pay",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/pay/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/pass",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/pass/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/status",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/status/",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/register/(.*)",
      "destination": "https://admin.nizhalcommunity.in/register/$1"
    },
    {
      "source": "/pay/(.*)",
      "destination": "https://admin.nizhalcommunity.in/pay/$1"
    },
    {
      "source": "/pass/(.*)",
      "destination": "https://admin.nizhalcommunity.in/pass/$1"
    },
    {
      "source": "/status/(.*)",
      "destination": "https://admin.nizhalcommunity.in/status/$1"
    },
    {
      "source": "/static/(.*)",
      "destination": "https://admin.nizhalcommunity.in/static/$1"
    },
    {
      "source": "/media/(.*)",
      "destination": "https://admin.nizhalcommunity.in/media/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

